+    def unique_visitors(self, code: str, since: datetime) -> int:
+        """Distinct daily visitor hashes; the key rotates daily, so this is the sum of
+        daily uniques over the window (a returning visitor counts once per day)."""
+        row = (
+            self.db.connection()
+            .execute(
+                "SELECT COUNT(DISTINCT visitor_hash) AS n FROM clicks"
+                " WHERE code = ? AND clicked_at >= ? AND visitor_hash IS NOT NULL",
+                (code, since.isoformat()),
+            )
+            .fetchone()
+        )
+        return row["n"]
 
