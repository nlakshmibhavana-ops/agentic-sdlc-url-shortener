@@ -0,0 +1,12 @@
+from urllib.parse import urlparse
+
+class InvalidURL(Exception):
+    pass
+
+def validate_url(url):
+    parsed_url = urlparse(url)
+    if parsed_url.scheme.lower() in ('javascript', 'vbscript', 'data', 'file'):
+        raise InvalidURL(f'Unsafe URL scheme: {parsed_url.scheme}')
+    if parsed_url.netloc.lower().endswith('.example'):
+        raise InvalidURL(f'Unsafe domain: {parsed_url.netloc}')
+    return url